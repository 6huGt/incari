<!doctype html>
<!-- Incari single-file build, written by ./incari build --html.
DO NOT SHARE, UPLOAD OR PUBLISH THIS FILE.
It contains Minecraft's code and files, which Mojang doesn't allow redistributing. The Incari
project never publishes builds and gives nobody permission to. It is for your own use, on
your own machine; see docs/self-hosting.md. Incari is not affiliated with or endorsed by
Mojang or Microsoft. -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Incari Client</title>
  <link rel="icon" href="data:image/png;base64,">
  <style>
    /* The menus' photo and Incari's mark, written in by tools/backdrop/make_backdrop.py (inline, so
       the one-file build has them too): the game's loading screen and menus show the same photo. */
    :root { --incari-backdrop: url("data:image/jpeg;base64,"); --incari-mark: url("data:image/png;base64,"); }
    html, body { margin: 0; height: 100%; background: #0c131b; color: #dde6ee; font: 14px system-ui, sans-serif; }
    #incari-canvas { display: block; width: 100vw; height: 100vh; outline: none; }
    #incari-loader { position: fixed; inset: 0; display: flex; flex-direction: column; align-items: center;
      justify-content: center; gap: 12px; background: linear-gradient(rgba(12, 19, 27, 0.2), rgba(12, 19, 27, 0.45)),
      var(--incari-backdrop) center 35% / cover no-repeat, #0c131b; }
    #incari-loader::before { content: ""; width: 96px; height: 96px; background: var(--incari-mark) center / contain no-repeat;
      filter: drop-shadow(0 0 18px rgba(169, 220, 255, 0.55)); }
    #incari-loader[hidden] { display: none; }
    #incari-loader h1 { margin: 0 0 12px; font-size: 22px; font-weight: 300; letter-spacing: 0.4em; padding-left: 0.4em; text-transform: uppercase;
      color: #fff; text-shadow: 0 1px 8px rgba(12, 19, 27, 0.5); }
    /* The bar as the mark's comet, like the game's loading screen (LoadingLook): an ice-blue trail with a bright head. */
    #incari-track { width: min(420px, 80vw); height: 4px; border-radius: 2px; background: rgba(255, 255, 255, 0.18);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12); }
    #incari-bar { position: relative; width: 0; min-width: 4px; height: 100%; border-radius: 2px; background: #a9dcff;
      box-shadow: 0 0 8px rgba(169, 220, 255, 0.6); transition: width 120ms linear; }
    #incari-bar::after { content: ""; position: absolute; right: -6px; top: -4px; width: 12px; height: 12px; border-radius: 50%;
      background: radial-gradient(#fff 0 30%, rgba(169, 220, 255, 0.9) 45%, rgba(169, 220, 255, 0) 70%); }
    #incari-bar.indeterminate { animation: incari-pulse 1.2s ease-in-out infinite; }
    #incari-loader.failed #incari-bar { background: #e5534b; box-shadow: none; animation: none; }
    #incari-loader.failed #incari-bar::after { display: none; }
    #incari-status { font-size: 15px; color: #fff; text-shadow: 0 1px 6px rgba(12, 19, 27, 0.6); }
    #incari-detail { min-height: 1.4em; max-width: min(560px, 90vw); text-align: center; opacity: 0.8;
      text-shadow: 0 1px 6px rgba(12, 19, 27, 0.6); }
    #incari-track[hidden], #incari-choose[hidden] { display: none; }
    #incari-choose { display: flex; flex-direction: column; gap: 10px; width: min(480px, calc(100vw - 32px)); }
    .incari-pick { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; text-align: left;
      font: inherit; color: #dde6ee; background: rgba(16, 24, 34, 0.72); border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 10px; cursor: pointer; }
    .incari-pick:hover:not(:disabled), .incari-pick:focus-visible { border-color: #a9dcff; outline: none; }
    .incari-pick:disabled { cursor: not-allowed; opacity: 0.55; }
    #incari-pick-fast { background: rgba(24, 40, 58, 0.78); border-color: rgba(169, 220, 255, 0.45); }
    .incari-pick-title { display: flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 600; color: #fff; }
    .incari-badge { padding: 1px 8px; border-radius: 10px; font-size: 12px; font-weight: 600;
      color: #0b1a2a; background: #a9dcff; }
    .incari-badge.quiet { color: #dde6ee; background: rgba(255, 255, 255, 0.14); }
    .incari-pick-text { font-size: 13px; opacity: 0.8; }
    .incari-pick-why { font-size: 13px; color: #e5a04b; }
    .incari-pick-why:empty { display: none; }
    .incari-pick-hint { margin: 2px 0 0; font-size: 13px; opacity: 0.8; text-align: center;
      text-shadow: 0 1px 6px rgba(12, 19, 27, 0.6); }
    @keyframes incari-pulse { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }
  </style>
</head>
<body>
  <canvas id="incari-canvas"></canvas>
  <div id="incari-loader" role="status" aria-live="polite">
    <h1>Incari</h1>
    <div id="incari-track"><div id="incari-bar"></div></div>
    <div id="incari-status">Loading</div>
    <div id="incari-detail"></div>
    <!-- Where both builds can run, the player picks one (boot.ts, ADR 0036); `?build=fast|compatible`
         skips this. Fast is the JSPI build, Compatible the coroutine build. -->
    <div id="incari-choose" role="group" aria-labelledby="incari-status" hidden>
      <button id="incari-pick-fast" class="incari-pick" type="button" aria-describedby="incari-why-fast">
        <span class="incari-pick-title">Fast <span class="incari-badge">Recommended</span></span>
        <span class="incari-pick-text">Higher frame rates, a smaller download and faster loading. Needs a recent
          browser.</span>
        <span class="incari-pick-why" id="incari-why-fast"></span>
      </button>
      <button id="incari-pick-compatible" class="incari-pick" type="button" aria-describedby="incari-why-compatible">
        <span class="incari-pick-title">Compatible <span class="incari-badge quiet">For older browsers</span></span>
        <span class="incari-pick-text">Works in Safari and older versions of Chrome and Firefox, but runs slower.</span>
        <span class="incari-pick-why" id="incari-why-compatible"></span>
      </button>
      <p class="incari-pick-hint">Choose Compatible only if Fast won't start in your browser.</p>
    </div>
  </div>
  <noscript>The game needs JavaScript.</noscript>
  <!-- The loader (src/main/ts/boot.ts, types stripped by :app-web:pageScripts). Builds contain
       Mojang code: this page is for your own machine or your own server, never published. -->
  <script type="module">
/**
 * The single-file page (`./incari build --html`, ADR 0057): the whole build in one HTML file that
 * opens straight from the disk. `tools/webbuild`'s `SingleFile` puts every file of the web folder in
 * the page as base64 (gzipped where that helps) and this script in it, inline. It serves those files
 * to the page and to every worker by the names they already fetch them by, so the game's code is the
 * same as in the folder's build.
 *
 * A `file://` page can't fetch the files beside it, start a module worker from a Blob URL, or use the
 * origin private file system, and its workers can't read the page's Blob URLs. A classic worker from
 * a Blob URL works, shares the page's IndexedDB, and can import its own Blob URLs. So:
 *
 * - The page and every worker get a shim ({@link installFiles}) that answers `fetch`,
 *   `importScripts` and `new Worker` for the embedded files from their own Blobs.
 * - A worker starts as a classic one that installs the shim, then runs its real script (as a module
 *   if one was asked for).
 * - A worker asks the page through a port for a file it doesn't have yet.
 * - The storage worker falls back to IndexedDB by itself.
 *
 * {@link installFiles} and {@link startWorker} are copied into each worker by their source text, so
 * they use nothing from this module, only their parameters and the realm's globals.
 */

/** What a realm's shim is set up with. Everything here can be posted to a worker. */
                            
                                                                                                              
                        
                                                    
                                    
                                                                                                     
                                                 
                                                                                               
                        
                                                              
                              
                                                                                        
                                 
 

/** A worker's real script: an embedded file (`path`), or a Blob the page made from source. */
                               
                               
                      
                           
 

/** What a realm's shim offers its code. */
                             
                                                                                                 
                            
                                                                                                 
                                           
                                     
                                             
 

/** The globals the shim replaces or uses. */
                            
                                                                             
                                                                      
                                              
                           
 

/** A file the page decodes when it's first asked for. */
                                                             

/**
 * Installs the shim on `scope`. `decode` is the page's; a worker asks `setup.port` instead.
 * Self-contained: copied into workers by its source.
 */
export function installFiles(scope           , setup           , decode          )             {
  const all = new Set(setup.paths);
  const blobs = new Map              (Object.entries(setup.blobs));
  const pending = new Map                              ();
  // Blob URLs made in this realm: by embedded file, and the modules' back to their file, so a worker
  // started from `import.meta.url` (game-worker.ts) is one of the files again.
  const urls = new Map                ();
  const modules = new Map                         ();
  const moduleFiles = new Map                ();
  // Script Blobs this realm made URLs of (the storage and program workers' sources), to start
  // those workers from.
  const scripts = new Map              ();
  const realFetch = scope.fetch.bind(scope);
  const RealWorker = scope.Worker;
  const realImportScripts = scope.importScripts?.bind(scope);
  const createObjectUrl = URL.createObjectURL.bind(URL);
  const revokeObjectUrl = URL.revokeObjectURL.bind(URL);

  const asked = new Map                                     ();
  let nextAsk = 0;
  const port = setup.port;
  if (port !== undefined) {
    port.onmessage = (event                                                 ) => {
      asked.get(event.data.id)?.(event.data.blob);
      asked.delete(event.data.id);
    };
  }
  const fromPage          =
    decode ??
    ((path) =>
      port === undefined
        ? Promise.resolve(null)
        : new Promise((resolve) => {
            const id = nextAsk++;
            asked.set(id, resolve);
            port.postMessage({ id, path });
          }));

  /** The embedded file `url` names, relative to the page's folder, or null if it names none. */
  function fileOf(url        )                {
    const module = moduleFiles.get(url);
    if (module !== undefined) {
      return module;
    }
    let path        ;
    if (/^[a-zA-Z][a-zA-Z0-9+.-]*:/.test(url)) {
      if (!url.startsWith(setup.base)) {
        return null;
      }
      path = decodeURIComponent(url.slice(setup.base.length).replace(/[?#].*$/s, ""));
    } else {
      try {
        const href = new URL(url, "https://incari.offline/").href;
        if (!href.startsWith("https://incari.offline/")) {
          return null;
        }
        path = decodeURIComponent(href.slice("https://incari.offline/".length).replace(/[?#].*$/s, ""));
      } catch {
        return null;
      }
    }
    return all.has(path) ? path : null;
  }

  /** Whether `path` stays in `blobs` after it's read: scripts and modules workers may ask for again. */
  function keepCached(path        )          {
    return path.endsWith(".js") || path.endsWith(".wasm") || path === "client.jar";
  }

  function blobOf(path        )                       {
    const known = blobs.get(path);
    if (known !== undefined) {
      return Promise.resolve(known);
    }
    let waiting = pending.get(path);
    if (waiting === undefined) {
      waiting = fromPage(path).then((blob) => {
        pending.delete(path);
        if (blob !== null && keepCached(path)) {
          blobs.set(path, blob);
        }
        return blob;
      });
      pending.set(path, waiting);
    }
    return waiting;
  }

  function urlOf(path        )         {
    let url = urls.get(path);
    if (url === undefined) {
      const blob = blobs.get(path);
      if (blob === undefined) {
        throw new Error(`${path} isn't loaded yet`);
      }
      url = createObjectUrl(blob);
      urls.set(path, url);
    }
    return url;
  }

  /** The page's scripts import no cycle, so each module's imports are made first. */
  function moduleUrl(path        )                  {
    let made = modules.get(path);
    if (made === undefined) {
      made = (async () => {
        const blob = await blobOf(path);
        if (blob === null) {
          throw new Error(`No ${path} in this file`);
        }
        const source = await blob.text();
        const imports = /(\b(?:from|import)\s*\(?\s*)(["'])(\.{1,2}\/[^"'\n]+)\2/g;
        const targets = new Map                ();
        for (const match of source.matchAll(imports)) {
          const specifier = match[3] ?? "";
          const target = fileOf(new URL(specifier, "https://incari.offline/" + path).pathname.slice(1));
          if (target !== null && !targets.has(specifier)) {
            targets.set(specifier, await moduleUrl(target));
          }
        }
        const rewritten = source.replace(imports, (whole        , before        , quote        , specifier        ) => {
          const target = targets.get(specifier);
          return target === undefined ? whole : before + quote + target + quote;
        });
        const url = createObjectUrl(new Blob([rewritten], { type: "text/javascript" }));
        moduleFiles.set(url, path);
        return url;
      })();
      modules.set(path, made);
    }
    return made;
  }

  scope.fetch = async (input, init) => {
    const path = fileOf(input instanceof Request ? input.url : String(input));
    if (path === null) {
      return realFetch(input, init);
    }
    const blob = await blobOf(path);
    return blob === null ? new Response(null, { status: 404, statusText: "Not Found" }) : new Response(blob);
  };

  URL.createObjectURL = (object) => {
    const url = createObjectUrl(object);
    if (object instanceof Blob && object.type.includes("javascript")) {
      scripts.set(url, object);
    }
    return url;
  };
  URL.revokeObjectURL = (url) => {
    scripts.delete(url);
    revokeObjectUrl(url);
  };

  if (realImportScripts !== undefined) {
    scope.importScripts = (...requested) => {
      realImportScripts(
        ...requested.map((url) => {
          const path = fileOf(url);
          return path === null ? url : urlOf(path);
        }),
      );
    };
  }

  let shimUrl                = null;
  if (RealWorker !== undefined) {
    // A function, not a class: `new` returns the real worker it makes.
    const OfflineWorker = function (url              , options                )         {
      const href = String(url);
      const path = fileOf(href);
      const blob = path === null ? scripts.get(href) : blobs.get(path);
      if (blob === undefined) {
        return new RealWorker(url, options);
      }
      shimUrl ??= createObjectUrl(new Blob([setup.shim], { type: "text/javascript" }));
      const worker = new RealWorker(shimUrl, options?.name === undefined ? {} : { name: options.name });
      const channel = new MessageChannel();
      channel.port1.onmessage = (event                                            ) => {
        void blobOf(event.data.path).then((found) => {
          channel.port1.postMessage({ id: event.data.id, blob: found });
        });
      };
      // Only scripts go up front (importScripts is synchronous); workers ask the port for modules and zips.
      const scriptBlobs                       = {};
      for (const [name, entry] of blobs) {
        if (name.endsWith(".js")) {
          scriptBlobs[name] = entry;
        }
      }
      const files            = {
        base: setup.base,
        paths: setup.paths,
        blobs: scriptBlobs,
        shim: setup.shim,
        port: channel.port2,
        script: { path, blob, module: options?.type === "module" },
      };
      worker.postMessage({ incariFiles: files }, [channel.port2]);
      return worker;
    };
    scope.Worker = OfflineWorker                                                                         ;
  }

  const access             = {
    url(href) {
      const path = fileOf(href);
      return path === null ? href : urlOf(path);
    },
    moduleUrl,
    async start(script) {
      if (script.module) {
        await import(script.path === null ? createObjectUrl(script.blob) : await moduleUrl(script.path));
      } else if (realImportScripts !== undefined) {
        realImportScripts(createObjectUrl(script.blob));
      }
    },
  };
  scope.incariFiles = access;
  return access;
}

/** The parts of a worker's scope {@link startWorker} uses. */
                                               
                                                                                   
                                                                                      
                                       
                                                            
 

/**
 * A worker's first script: waits for the page's files, installs the shim, and runs the real script.
 * Messages that come before that script listens are held and handed to it in order. Self-contained:
 * copied into workers by its source.
 */
export function startWorker(scope            , install                     )       {
  const held                          = [];
  const hold = (event                       )       => {
    held.push(event);
  };
  const first = (event                                                  )       => {
    const setup = event.data?.incariFiles;
    if (setup?.script === undefined) {
      return;
    }
    scope.removeEventListener("message", first);
    scope.addEventListener("message", hold);
    install(scope, setup)
      .start(setup.script)
      .then(
        () => {
          scope.removeEventListener("message", hold);
          for (const message of held.splice(0)) {
            scope.dispatchEvent(new MessageEvent("message", { data: message.data, ports: [...message.ports] }));
          }
        },
        (error         ) => {
          // An uncaught error, so the worker's `onerror` on the other side hears of it.
          scope.setTimeout(() => {
            throw error;
          }, 0);
        },
      );
  };
  scope.addEventListener("message", first);
}

/** The source of a worker's first script. */
export function shimSource()         {
  return `"use strict";\n(${startWorker.toString()})(self, ${installFiles.toString()});\n`;
}

/** How `SingleFile` marks an embedded file: `<script type=...>` with the base64 as its text. */
export const FILE_TYPE = "application/x-incari-file";

/** One embedded file's element, as the page reads it. */
                               
                        
                                                                                                         
                        
                         
                                                      
                 
 

/**
 * Base64 to bytes, a chunk at a time where the browser has no `Uint8Array.fromBase64`.
 *
 * The old fallback decoded a `data:` URL, which meant a base64 string, a URL of it, a request and a
 * response: several copies of a 60-90 MB file alive at once, on the machines with the least to
 * spare. Chunks of 4 characters' worth of bits per step hold one 3 MB string at a time instead.
 */
export function base64Bytes(text        )                          {
  const native = (Uint8Array                                                              ).fromBase64;
  if (native !== undefined) {
    return native.call(Uint8Array, text);
  }
  const padding = text.endsWith("==") ? 2 : text.endsWith("=") ? 1 : 0;
  const bytes = new Uint8Array((text.length >> 2) * 3 - padding);
  // A multiple of 4, so every chunk but the last is whole base64 on its own.
  const chunk = 4 * 1024 * 1024;
  let at = 0;
  for (let i = 0; i < text.length; i += chunk) {
    const decoded = atob(text.slice(i, i + chunk));
    for (let j = 0; j < decoded.length; j++) {
      bytes[at + j] = decoded.charCodeAt(j);
    }
    at += decoded.length;
  }
  return bytes;
}

/** Decodes one embedded file into a Blob of its type. */
export async function decodeFile(file              )                {
  const bytes = base64Bytes(file.text());
  if (!file.gzip) {
    return new Blob([bytes], { type: file.type });
  }
  const unpacked = await new Response(new Blob([bytes]).stream().pipeThrough(new DecompressionStream("gzip"))).blob();
  return new Blob([unpacked], { type: file.type });
}

/** The folder prefix of `href` (works for `blob:` and `about:` URLs where `new URL(".", href)` throws). */
export function baseUrlOf(href        )         {
  try {
    return new URL(".", href).href;
  } catch {
    const clean = href.replace(/[?#].*$/s, "");
    const slash = clean.lastIndexOf("/");
    return slash >= 0 ? clean.slice(0, slash + 1) : `${clean}/`;
  }
}

/**
 * The page's side: installs the shim over the embedded files and starts `boot.js`. The scripts are
 * decoded first (workers and `importScripts` need them at once); the rest when first fetched, so
 * the build the player doesn't pick and the languages they don't use are never decoded.
 */
export async function startPage(page                    , files                         )                {
  const byPath = new Map(files.map((file) => [file.path, file]));
  const blobs                       = {};
  for (const file of files) {
    if (file.path.endsWith(".js")) {
      blobs[file.path] = await decodeFile(file);
      byPath.delete(file.path);
    }
  }
  const decodeLater          = async (path) => {
    const file = byPath.get(path);
    if (file === undefined) {
      return null;
    }
    byPath.delete(path);
    // Drop the other build's embedded text once one is picked, freeing ~15-35 MB of DOM memory.
    if (path === "incari-fast.wasm") {
      byPath.get("incari.wasm")?.text();
      byPath.delete("incari.wasm");
    } else if (path === "incari.wasm") {
      byPath.get("incari-fast.wasm")?.text();
      byPath.delete("incari-fast.wasm");
    }
    return decodeFile(file);
  };
  const access = installFiles(
    page,
    {
      base: baseUrlOf(page.location.href),
      paths: files.map((file) => file.path),
      blobs,
      shim: shimSource(),
    },
    decodeLater,
  );
  const boot = page.document.createElement("script");
  boot.type = "module";
  boot.src = await access.moduleUrl("boot.js");
  page.document.body.append(boot);
}

/** The embedded files in `document`, each element removed once its text is read. */
export function embeddedFiles(document          )                 {
  return Array.from(document.querySelectorAll                   (`script[type="${FILE_TYPE}"]`), (element) => ({
    path: element.dataset.path ?? "",
    type: element.dataset.type ?? "application/octet-stream",
    gzip: element.dataset.encoding === "gzip",
    text: () => {
      const text = element.text;
      element.remove();
      return text;
    },
  }));
}

/**
 * Makes `navigator.sendBeacon` say it couldn't queue the beacon (false) instead of throwing, as
 * Chromium does on a `file://` page. Scripts that aren't the game's (school monitoring, analytics)
 * beacon when the tab is hidden, and their uncaught error would end the game (boot.ts).
 */
export function quietBeacons(navigator                               )       {
  const send = navigator.sendBeacon.bind(navigator);
  navigator.sendBeacon = (url, data) => {
    try {
      return send(url, data);
    } catch {
      return false;
    }
  };
}

/** What `SingleFile` calls after this script: starts the page, or says on the loading screen why it couldn't. */
export function start(page                    )       {
  if (typeof page.navigator.sendBeacon === "function") {
    quietBeacons(page.navigator);
  }
  startPage(page, embeddedFiles(page.document)).catch((error         ) => {
    const status = page.document.getElementById("incari-status");
    const detail = page.document.getElementById("incari-detail");
    if (status !== null && detail !== null) {
      status.textContent = "The game couldn't start";
      detail.textContent = String(error);
    }
    console.error(
      "[Incari] Crashed: " + (error instanceof Error && error.stack !== undefined ? error.stack : String(error)),
    );
  });
}

start(window);
</script>
<script type="application/x-incari-file" data-path="features.js" data-type="text/javascript" data-encoding="gzip"></script>
<script type="application/x-incari-file" data-path="wakeups.js" data-type="text/javascript" data-encoding="gzip"></script>
<script type="application/x-incari-file" data-path="jspi.js" data-type="text/javascript" data-encoding="gzip"></script>
<script type="application/x-incari-file" data-path="loader.js" data-type="text/javascript" data-encoding="gzip"></script>
<script type="application/x-incari-file" data-path="game-worker.js" data-type="text/javascript" data-encoding="gzip"></script>
<script type="application/x-incari-file" data-path="boot.js" data-type="text/javascript" data-encoding="gzip"></script>
